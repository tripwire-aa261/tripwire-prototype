# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Keys stay local (see twin/env.py). Commit only .env.example.
.env
.env.*
!.env.example

# Raw downloads (re-created by tools/fetch_towers.py)
data/raw/

# Runs you make yourself stay local. Committed: the v0.4 facility demos and the v0.2 Hays reference
# (for the archived v0.3 viewer). Regenerate any other run with python -m twin.run (see README).
web/runs/*.json
web/runs/*.bin
web/runs/sweeps/custom-*
!web/runs/seed-m210.*
!web/runs/hancock-seed-m210.*
!web/runs/fulton-seed-m210.*
!web/runs/fulton-seed-m210-optimistic.*
!web/runs/hays-upgraded-m210.*
!web/runs/cost_model.json
!web/runs/calibration.json
!web/runs/broadcast_study.json
!web/runs/platform_v06.json
# Run lists are rebuilt from the files present when serve.py starts.
web/runs/index.json
web/runs/sweeps/index.json
.vercel
# v0.4.2: the 12 precomputed 3D replays (tools/make_replays.py) and their manifest
!web/runs/replay-*
!web/runs/replays.json
data/cache/
# v0.4.4: the hover / pole-height study, read by tools/build_assumptions_doc.py
!web/runs/hover_feasibility.json
!web/runs/placement_study.json
